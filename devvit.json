{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "vipcentral",
  "blocks": {
    "entry": "src/blocks/config/main.ts",
    "triggers": [
      "onPostSubmit",
      "onCommentSubmit",
      "onCommentUpdate",
      "onAppInstall",
      "onAppUpgrade"
    ]
  },
  "media": {
    "dir": "assets"
  },
  "marketingAssets": {
    "icon": "assets/vipcentral.png"
  },
  "forms": {
    "post-create-form": "/internal/form/create-post"
  },
  "dev": {
    "subreddit": "vipcentral_dev"
  },
  "permissions": {
    "reddit": true
  }
}